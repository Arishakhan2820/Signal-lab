# Placeholders only. Never commit real values. Educational project: synthetic data only.
ENV=local
DATA_MODE=synthetic_only
ASSESSMENTS_ENABLED=false
INFERENCE_ENABLED=false
EMAIL_MODE=log
APP_ORIGIN=http://localhost:3000
COOKIE_PROFILE=dev            # 'secure' (default) is required in staging/production
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-key>
JWT_SECRET=<legacy-jwt-secret-or-configure-JWKS-later>
DATABASE_URL=postgresql://<restricted-api-role>@<host>:6543/postgres
CSRF_SECRET=<32+ random chars>
ALLOWLIST_PEPPER=<32+ random chars>
REDIS_URL=                    # required in staging/production
# Worker only (NEVER set these in the public API deployment):
# WORKER_DATABASE_URL=...
# SUPABASE_SERVICE_KEY=...
# ERASURE_PEPPER=...
